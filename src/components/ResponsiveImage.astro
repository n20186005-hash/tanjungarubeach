---
import { webpSrcset } from '../lib/images';

interface Props {
  src: string;
  alt: string;
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  width?: number;
  height?: number;
}

const {
  src,
  alt,
  sizes = '100vw',
  class: className,
  loading = 'lazy',
  fetchpriority,
  width,
  height,
} = Astro.props;
---

<picture class="contents">
  <source type="image/webp" srcset={webpSrcset(src)} sizes={sizes} />
  <img
    src={src}
    alt={alt}
    sizes={sizes}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    width={width}
    height={height}
    class={className}
  />
</picture>

---
const options = [
  {
    "icon": "plane",
    "title": "Dari Lapangan Terbang (BKI)",
    "est": "Semak aplikasi",
    "detail": "Pilih Pantai Tanjung Aru sebagai destinasi teksi atau e-hailing. Semak masa perjalanan, titik jemputan lapangan terbang dan tambang sebelum mengesahkan tempahan."
  },
  {
    "icon": "bus",
    "title": "Bas awam",
    "est": "Sahkan laluan",
    "detail": "Semak dengan pengendali atau pemandu sama ada perkhidmatan semasa berhenti berhampiran pintu masuk pantai yang dipilih. Sahkan tambang dan bas terakhir sebelum bertolak."
  },
  {
    "icon": "car",
    "title": "Teksi / e-hailing dari bandar",
    "est": "Ikut trafik",
    "detail": "Gunakan alamat hotel sebagai titik mula dan pin pantai sebagai destinasi. Simpan titik jemputan pulang; perjalanan menjelang senja mungkin lebih lama."
  },
  {
    "icon": "walk",
    "title": "Berjalan kaki / berbasikal",
    "est": "Semak laluan",
    "detail": "Periksa jarak sebenar dari lokasi anda, laluan pejalan kaki dan cuaca. Jangan bergantung pada satu anggaran jarak untuk semua kawasan pusat bandar."
  }
];

const tips = [
  'Puncak kesesakan berlaku menjelang waktu senja (17:00–18:30) — rancang perjalanan lebih awal.',
  'Semak ketersediaan kenderaan untuk perjalanan pulang sebelum lewat malam.',
  'Gunakan pin peta Pantai Tanjung Aru dan ikut papan tanda di lokasi.',
];
---

<section id="pengangkutan" class="bg-ocean-950 py-20 text-white sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sunset-400">Pengangkutan</p>
      <h2 class="mt-3 text-balance font-display text-3xl font-extrabold sm:text-4xl">
        Cara mudah sampai ke Tanjung Aru
      </h2>
      <p class="mt-5 text-base leading-relaxed text-white/75">
        Pilih pintu masuk pantai dan gunakan pin peta dari lokasi anda. Masa perjalanan, tambang dan laluan bas berubah mengikut titik mula dan keadaan semasa.
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        options.map((o) => (
          <article class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition hover:border-sunset-400/40 hover:bg-white/10">
            <div class="flex items-center justify-between">
              <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-sunset-500/20 text-sunset-300">
                {
                  o.icon === 'plane' ? (
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>
                  ) : o.icon === 'bus' ? (
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M8 6v6m4-6v6M4 6h16v11H4zM4 6c0-2 2-3 8-3s8 1 8 3v11H4z"/><path d="M8 17h8v1a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1z"/></svg>
                  ) : o.icon === 'car' ? (
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M19 17H5v-5l1-5h12l1 5v5z"/><path d="M5 17v2a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-2M16 17v2a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-2"/><circle cx="8" cy="12" r="0.5"/><circle cx="16" cy="12" r="0.5"/></svg>
                  ) : (
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><circle cx="13" cy="4" r="2"/><path d="M10 20v-4l-2-2M10 14h4l1 2 3 3M13 20v-4"/></svg>
                  )
                }
              </span>
              <span class="text-xs font-bold uppercase tracking-wide text-sand-300">{o.est}</span>
            </div>
            <h3 class="mt-4 text-base font-bold">{o.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/70">{o.detail}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-10 rounded-2xl border border-white/10 bg-white/5 p-6">
      <h3 class="flex items-center gap-2 text-base font-bold text-sand-200">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5 text-sunset-400" aria-hidden="true"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-4 10.5c.7.6 1 1.4 1 2.5h6c0-1.1.3-1.9 1-2.5A6 6 0 0 0 12 3Z" /></svg>
        Petua pengangkutan
      </h3>
      <ul class="mt-3 space-y-2 text-sm leading-relaxed text-white/75">
        {tips.map((t) => (
          <li class="flex gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-sunset-400"></span>
            {t}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

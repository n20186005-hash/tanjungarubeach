---
const beaches = [
  {
    name: 'Pantai Pertama (First Beach)',
    tag: 'Paling sibuk',
    desc: 'Kawasan utama dengan gerai makanan, taman permainan kanak-kanak dan kemudahan awam. Sudut terbaik untuk menyaksikan matahari terbenam.',
    img: '/gallery/pantai-tanjung-aru-5.jpg',
    points: ['Gerai makanan & minuman', 'Taman permainan kanak-kanak', 'Kedai cenderamata'],
  },
  {
    name: 'Pantai Kedua (Second Beach)',
    tag: 'Suasana keluarga',
    desc: 'Bahagian yang lebih tenang, sesuai untuk berkelah dan bersantai. Pokok ru yang rendang memberikan teduhan semula jadi.',
    img: '/gallery/pantai-tanjung-aru-6.jpg',
    points: ['Kawasan berkelah', 'Teduhan pokok ru', 'Lebih tenang'],
  },
  {
    name: 'Pantai Ketiga (Third Beach)',
    tag: 'Paling tenang',
    desc: 'Bahagian paling hujung dan paling sunyi, menghala ke arah resort. Pilihan untuk yang mahukan ketenangan sepenuhnya.',
    img: '/gallery/pantai-tanjung-aru-7.jpg',
    points: ['Sunyi & tenang', 'Pemandangan resort', 'Sesuai untuk jalan-jalan santai'],
  },
];

const activities = ['Berenang', 'Berkayak', 'Berkelah', 'Bermain pasir', 'Bersiar-siar', 'Bergambar senja', 'Bersukan pantai', 'Menunggu pasar malam'];

const safety = [
  'Beri perhatian kepada papan tanda keselamatan dan amaran arus.',
  'Berenang di kawasan yang diawasi; awasi kanak-kanak sentiasa.',
  'Elakkan berkunjung semasa hujan lebat atau laut bergelora.',
  'Bawa air minuman dan pelindung matahari — tidak banyak gerai di kawasan Pantai Kedua dan Ketiga.',
];
---

<section id="pantai" class="bg-white py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sunset-600">Tiga Bahagian Pantai</p>
      <h2 class="mt-3 text-balance font-display text-3xl font-extrabold text-ocean-950 sm:text-4xl">
        Satu pantai, tiga suasana berbeza
      </h2>
      <p class="mt-5 text-base leading-relaxed text-ocean-900/75">
        Walaupun dipanggil "Pantai Tanjung Aru", pesisir ini sebenarnya terdiri daripada tiga bahagian yang berbeza.
        Pilih mengikut suasana yang anda inginkan.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {beaches.map((b) => (
        <article class="group overflow-hidden rounded-3xl border border-sand-200 bg-sand-50 shadow-sm transition hover:shadow-lg">
          <div class="relative h-52 overflow-hidden">
            <img
              src={b.img}
              alt={b.name}
              loading="lazy"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
            />
            <span class="absolute left-4 top-4 rounded-full bg-ocean-950/80 px-3 py-1 text-xs font-semibold text-sand-200 backdrop-blur">
              {b.tag}
            </span>
          </div>
          <div class="p-6">
            <h3 class="text-lg font-bold text-ocean-950">{b.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ocean-900/70">{b.desc}</p>
            <ul class="mt-4 space-y-1.5">
              {b.points.map((p) => (
                <li class="flex items-center gap-2 text-sm text-ocean-900/80">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 shrink-0 text-sunset-500" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" /></svg>
                  {p}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-2">
      <div class="rounded-3xl bg-sand-100 p-7">
        <h3 class="flex items-center gap-2 text-lg font-bold text-ocean-950">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5 text-sunset-600" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" /></svg>
          Aktiviti yang boleh dilakukan
        </h3>
        <div class="mt-4 flex flex-wrap gap-2">
          {activities.map((a) => (
            <span class="rounded-full border border-ocean-800/20 bg-white px-3.5 py-1.5 text-sm font-medium text-ocean-800">
              {a}
            </span>
          ))}
        </div>
      </div>

      <div class="rounded-3xl bg-ocean-950 p-7 text-white">
        <h3 class="flex items-center gap-2 text-lg font-bold">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5 text-sand-300" aria-hidden="true"><path d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0ZM12 9v4m0 4h.01" /></svg>
          Keselamatan di pantai
        </h3>
        <ul class="mt-4 space-y-2.5 text-sm leading-relaxed text-white/80">
          {safety.map((s) => (
            <li class="flex gap-2">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-sunset-400"></span>
              {s}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

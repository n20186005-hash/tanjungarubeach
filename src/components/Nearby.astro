---
const places = [
  {
    name: 'Shangri-La Tanjung Aru Resort',
    tag: '0.5 km',
    desc: 'Resort mewah dengan taman laut dan lounge senja — pemandangan matahari terbenam yang terkenal.',
    icon: 'hotel',
  },
  {
    name: 'Taman Perdana (Taman Bunga)',
    tag: '1 km',
    desc: 'Taman bunga yang indah dengan pancutan air muzik pada waktu malam, berdekatan Tanjung Aru.',
    icon: 'park',
  },
  {
    name: 'Masjid Bandaraya Kota Kinabalu',
    tag: '3 km',
    desc: 'Masjid terapung yang ikonik di tepi laut — latar foto yang menakjubkan.',
    icon: 'mosque',
  },
  {
    name: 'Jesselton Point',
    tag: '4 km',
    desc: 'Terminal feri ke pulau-pulau Taman Marin Tunku Abdul Rahman; juga persisiran pantai pusat bandar.',
    icon: 'ferry',
  },
  {
    name: 'Gaya Street (Sunday Market)',
    tag: '4.5 km',
    desc: 'Pasar minggu yang meriah setiap Ahad — cenderamata, makanan dan suasana tempatan.',
    icon: 'market',
  },
  {
    name: 'Signal Hill Observatory',
    tag: '5 km',
    desc: 'Platform pandangan di atas bukit dengan panorama seluruh bandar Kota Kinabalu dan laut.',
    icon: 'view',
  },
];

const icons = {
  hotel: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5"><path d="M2 20h20M4 20V8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12M9 20v-4h6v4M9 6V4h6v2M9 10h.01M15 10h.01" /></svg>',
  park: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5"><path d="M12 22v-5m0-4c0-3-1.5-5-4-5-1 3 .5 5 2 6-2 1-4 3-3 7h10c1-4-1-6-3-7 1.5-1 3-3 2-6-2.5 0-4 2-4 5z" /></svg>',
  mosque: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5"><path d="M12 3c1 2 1 3.5 0 5-1-1.5-1-3 0-5zM12 8v2M4 21c0-4 3-7 8-7s8 3 8 7M12 8c-2 0-4 1.5-4 4h8c0-2.5-2-4-4-4zM2 21h20" /></svg>',
  ferry: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5"><path d="M2 16a8 8 0 0 1 20 0M2 16c0-3 3-5 10-5s10 2 10 5M12 5v6M2 16l1 4h18l1-4" /></svg>',
  market: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5"><path d="M3 9h18l-1.5 11a2 2 0 0 1-2 1.8H6.5a2 2 0 0 1-2-1.8L3 9zM6 9V7a6 6 0 0 1 12 0v2" /></svg>',
  view: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" /><circle cx="12" cy="12" r="3" /></svg>',
};
---

<section id="sekitar" class="bg-sand-50 py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sunset-600">Tarikan Sekitar</p>
      <h2 class="mt-3 text-balance font-display text-3xl font-extrabold text-ocean-950 sm:text-4xl">
        Gabungkan lawatan dengan tempat menarik lain
      </h2>
      <p class="mt-5 text-base leading-relaxed text-ocean-900/75">
        Kawasan sekitar Tanjung Aru dan pusat bandar Kota Kinabalu menawarkan banyak tarikan yang mudah digabungkan dalam
        satu perjalanan.
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {places.map((p) => (
        <article class="flex gap-4 rounded-2xl border border-sand-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
          <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-ocean-800 text-sand-200" set:html={icons[p.icon as keyof typeof icons]}></span>
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="font-bold text-ocean-950">{p.name}</h3>
              <span class="rounded-full bg-sand-200 px-2 py-0.5 text-xs font-semibold text-ocean-900/70">{p.tag}</span>
            </div>
            <p class="mt-1.5 text-sm leading-relaxed text-ocean-900/70">{p.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

---
const timeline = [
  { time: '16:00', label: 'Tiba di pantai', text: 'Pilih tempat duduk, sewa payung atau cari sudut santai di bawah pokok ru.' },
  { time: '16:30', label: 'Cahaya keemasan', text: 'Cahaya matahari mulai keemasan — masa terbaik untuk bergambar bersama keluarga.' },
  { time: '17:30', label: 'Jam emas', text: 'Langit bertukar jingga dan ungu. Puncak pemandangan sebelum matahari terbenam.' },
  { time: '18:00–18:30', label: 'Matahari terbenam', text: 'Matahari tenggelam di kaki langit Laut China Selatan — detik paling dinanti.' },
  { time: '18:30+', label: 'Lampu menyala', text: 'Gerai makanan mula dibuka; nikmati makan malam di bawah langit senja.' },
];
---

<section id="senja" class="relative overflow-hidden bg-ocean-950 py-20 text-white sm:py-28">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -top-32 left-1/4 h-96 w-96 rounded-full bg-sunset-500/20 blur-3xl"></div>
    <div class="absolute bottom-0 right-0 h-72 w-72 rounded-full bg-ocean-500/20 blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sunset-400">Senja Bertaraf Dunia</p>
      <h2 class="mt-3 text-balance font-display text-3xl font-extrabold sm:text-4xl">
        Setiap petang, langit berubah menjadi kanvas
      </h2>
      <p class="mt-5 text-base leading-relaxed text-white/75">
        Tanjung Aru dianggap sebagai tempat terbaik di Kota Kinabalu untuk menyaksikan matahari terbenam. Laut China Selatan
        yang menghadap barat, langit yang bersih dan siluet rimbunan pokok ru mencipta pemandangan yang tidak dapat dilupakan.
        Waktu senja berubah mengikut musim — datanglah awal dan nikmati proses perubahan langit perlahan-lahan.
      </p>
    </div>

    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {timeline.map((t, i) => (
        <article class="relative rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm">
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center justify-center rounded-full bg-sunset-500 px-3 py-1 text-xs font-bold text-white">
              {t.time}
            </span>
            <span class="text-2xl font-black text-white/15">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <h3 class="mt-3 text-base font-bold text-sand-200">{t.label}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-white/70">{t.text}</p>
        </article>
      ))}
    </div>

    <div class="mt-10 flex flex-col items-start gap-3 rounded-2xl border border-sunset-500/30 bg-sunset-500/10 p-6 sm:flex-row sm:items-center">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-6 w-6 shrink-0 text-sunset-300" aria-hidden="true"><path d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0ZM12 9v4m0 4h.01" /></svg>
      <p class="text-sm leading-relaxed text-white/85">
        <strong class="text-sunset-300">Petua:</strong> waktu matahari terbenam di Sabah berubah sepanjang tahun (biasanya
        sekitar jam 18:00–18:30). Semak ramalan cuaca sebelum berkunjung — langit mendung boleh menutup pemandangan senja.
      </p>
    </div>
  </div>
</section>

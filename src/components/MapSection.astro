---
import { SITE } from '../data/site';
---

<section id="peta" class="bg-sand-50 py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-start gap-10 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sunset-600">Lokasi</p>
        <h2 class="mt-3 text-balance font-display text-3xl font-extrabold text-ocean-950 sm:text-4xl">
          Cari Pantai Tanjung Aru di peta
        </h2>
        <div class="mt-6 space-y-4 text-sm leading-relaxed text-ocean-900/80">
          <p class="flex gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5 shrink-0 text-ocean-800" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" /></svg>
            <span><strong class="text-ocean-950">Alamat:</strong> {SITE.address.street}, {SITE.address.locality}, {SITE.address.postalCode}, {SITE.address.region}, Malaysia</span>
          </p>
          <p class="flex gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5 shrink-0 text-ocean-800" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
            <span><strong class="text-ocean-950">Waktu operasi:</strong> {SITE.hours}</span>
          </p>
          <p class="flex gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5 shrink-0 text-ocean-800" aria-hidden="true"><path d="M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4" /><circle cx="12" cy="12" r="3.5" /></svg>
            <span><strong class="text-ocean-950">Koordinat:</strong> {SITE.lat}, {SITE.lng}</span>
          </p>
        </div>
        <a
          href={SITE.mapsUrl}
          target="_blank"
          rel="noopener"
          class="mt-6 inline-flex items-center gap-2 rounded-full bg-sunset-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-sunset-500/25 transition hover:bg-sunset-600"
        >
          Buka dalam Google Maps
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 0-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75v-4a.75.75 0 0 1 1.5 0v4A2.25 2.25 0 0 1 12.75 17h-8.5A2.25 2.25 0 0 1 2 14.75v-8.5A2.25 2.25 0 0 1 4.25 4h5a.75.75 0 0 1 0 1.5h-5Z" clip-rule="evenodd" /></svg>
        </a>
      </div>

      <div class="lg:col-span-3">
        <div class="overflow-hidden rounded-3xl border border-sand-200 shadow-lg">
          <iframe
            src={SITE.mapsEmbedSrc}
            width="100%"
            height="480"
            style="border:0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            title="Peta Pantai Tanjung Aru, Kota Kinabalu"
            class="block w-full"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>

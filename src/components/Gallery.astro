---
import { GALLERY_IMAGES } from '../data/site';

const visible = GALLERY_IMAGES.slice(0, 12);
---

<section id="galeri" class="bg-sand-50 py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sunset-600">Galeri Foto</p>
        <h2 class="mt-3 text-balance font-display text-3xl font-extrabold text-ocean-950 sm:text-4xl">
          Tangkapan sebenar di Tanjung Aru
        </h2>
        <p class="mt-4 text-base leading-relaxed text-ocean-900/75">
          Dari pasir keemasan sehinggalah langit senja yang memukau — sekilas pandang suasana sebenar pantai ini.
        </p>
      </div>
    </div>

    <div class="mt-12 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {visible.map((src, i) => (
        <button
          type="button"
          class="photo-item group relative block overflow-hidden rounded-2xl focus:outline-none focus-visible:ring-4 focus-visible:ring-sunset-400"
          data-src={src}
          data-alt={`Galeri Pantai Tanjung Aru ${i + 1}`}
          aria-label={`Buka foto ${i + 1} dalam skrin penuh`}
        >
          <img
            src={src}
            alt={`Pantai Tanjung Aru — foto ${i + 1}`}
            loading="lazy"
            class={`w-full object-cover transition duration-500 group-hover:scale-105 ${i % 5 === 0 ? 'aspect-[4/5]' : i % 3 === 0 ? 'aspect-square' : 'aspect-[4/3]'}`}
          />
          <span class="absolute inset-0 flex items-end justify-center bg-gradient-to-t from-ocean-950/60 to-transparent p-3 opacity-0 transition group-hover:opacity-100">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-6 w-6 text-white" aria-hidden="true"><path d="M4.25 2A2.25 2.25 0 0 0 2 4.25v2a.75.75 0 0 0 1.5 0v-2a.75.75 0 0 1 .75-.75h2a.75.75 0 0 0 0-1.5h-2ZM13.75 2a.75.75 0 0 0 0 1.5h2a.75.75 0 0 1 .75.75v2a.75.75 0 0 0 1.5 0v-2A2.25 2.25 0 0 0 15.75 2h-2ZM3.5 13.75a.75.75 0 0 0-1.5 0v2A2.25 2.25 0 0 0 4.25 18h2a.75.75 0 0 0 0-1.5h-2a.75.75 0 0 1-.75-.75v-2ZM18 13.75a.75.75 0 0 0-1.5 0v2a.75.75 0 0 1-.75.75h-2a.75.75 0 0 0 0 1.5h2A2.25 2.25 0 0 0 18 15.75v-2Z" /></svg>
          </span>
        </button>
      ))}
    </div>

    <p class="mt-8 text-center text-sm text-ocean-900/60">
      Lihat {GALLERY_IMAGES.length} foto di lokasi · buka setiap foto untuk paparan penuh
    </p>
  </div>
</section>

<!-- Lightbox -->
<div id="lightbox" class="fixed inset-0 z-[60] hidden items-center justify-center bg-ocean-950/95 p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-label="Paparan foto penuh">
  <button id="lightbox-close" class="absolute right-5 top-5 inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20" aria-label="Tutup">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-6 w-6"><path d="M18 6 6 18M6 6l12 12" /></svg>
  </button>
  <button id="lightbox-prev" class="absolute left-3 top-1/2 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20 sm:inline-flex" aria-label="Foto sebelumnya">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-6 w-6"><path d="m15 18-6-6 6-6" /></svg>
  </button>
  <img id="lightbox-img" src="" alt="" class="max-h-[85vh] max-w-full rounded-2xl object-contain shadow-2xl" />
  <button id="lightbox-next" class="absolute right-3 top-1/2 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20 sm:inline-flex" aria-label="Foto seterusnya">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-6 w-6"><path d="m9 18 6-6-6-6" /></svg>
  </button>
</div>

<script is:inline>
  const items = Array.from(document.querySelectorAll('.photo-item'));
  const lb = document.getElementById('lightbox');
  const lbImg = document.getElementById('lightbox-img');
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');
  let idx = 0;

  const show = (i) => {
    idx = (i + items.length) % items.length;
    const item = items[idx];
    lbImg.src = item.dataset.src;
    lbImg.alt = item.dataset.alt || '';
    lb.classList.remove('hidden');
    lb.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };
  const hide = () => {
    lb.classList.add('hidden');
    lb.classList.remove('flex');
    document.body.style.overflow = '';
  };

  items.forEach((item, i) => item.addEventListener('click', () => show(i)));
  closeBtn?.addEventListener('click', hide);
  prevBtn?.addEventListener('click', () => show(idx - 1));
  nextBtn?.addEventListener('click', () => show(idx + 1));
  lb?.addEventListener('click', (e) => {
    if (e.target === lb) hide();
  });
  document.addEventListener('keydown', (e) => {
    if (lb.classList.contains('hidden')) return;
    if (e.key === 'Escape') hide();
    if (e.key === 'ArrowLeft') show(idx - 1);
    if (e.key === 'ArrowRight') show(idx + 1);
  });
</script>

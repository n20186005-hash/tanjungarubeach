---
const faqs = [
  {
    "q": "Apakah waktu operasi Pantai Tanjung Aru?",
    "a": "Senarai Google Maps yang disemak pada 19 Oktober 2026 menunjukkan 10:00–23:00 setiap hari. Ini ialah waktu senarai tempat, bukan jaminan semua kawasan pantai atau gerai dibuka pada waktu sama. Ikut papan tanda setempat."
  },
  {
    "q": "Adakah dikenakan bayaran masuk?",
    "a": "Lawatan ke pantai awam tidak memerlukan tiket masuk. Makanan, parkir dan perkhidmatan pilihan mempunyai caj berasingan; semak kadar sebelum membeli."
  },
  {
    "q": "Bagaimana untuk ke Pantai Tanjung Aru dari pusat bandar?",
    "a": "Gunakan pin Pantai Tanjung Aru dalam peta untuk perjalanan dari hotel atau lapangan terbang. Semak harga dan masa perjalanan dalam aplikasi teksi atau e-hailing; tambang berubah mengikut lokasi dan trafik. Laluan, hentian serta perjalanan terakhir bas perlu disahkan dengan pengendali."
  },
  {
    "q": "Bilakah waktu terbaik untuk melihat matahari terbenam?",
    "a": "Rancang tiba 1–2 jam sebelum matahari terbenam pada tarikh lawatan. Masa berubah sepanjang tahun dan cuaca boleh menutup pemandangan. Gunakan jadual harian Kota Kinabalu yang dipautkan dalam bahagian senja."
  },
  {
    "q": "Apakah Tanjung Aru Beach 2?",
    "a": "Tanjung Aru Beach 2 merujuk kepada Pantai Kedua, salah satu bahagian pesisir Tanjung Aru. Pilih titik pertemuan yang tepat dalam peta kerana Pantai Pertama, Kedua dan Ketiga bukan satu titik masuk yang sama."
  },
  {
    "q": "Adakah terdapat tempat letak kereta?",
    "a": "Terdapat kawasan parkir berhampiran pantai. Semak akses, kadar dan papan tanda di lokasi; datang awal sebelum senja dan elakkan menghalang laluan keluar masuk."
  },
  {
    "q": "Adakah pantai sesuai untuk aktiviti keluarga?",
    "a": "Berjalan di pesisir, berkelah, bermain pasir dan melihat senja ialah pilihan lawatan keluarga. Awasi kanak-kanak dan semak keadaan laut serta arahan setempat sebelum sebarang aktiviti air."
  },
  {
    "q": "Adakah Perdana Park sama dengan Pantai Tanjung Aru?",
    "a": "Tidak. Perdana Park ialah taman berdekatan yang berasingan. Notis DBKK 2 Julai 2026 menyatakan pembukaan semula 4 Julai, waktu 07:00–19:00 dan penutupan air pancut serta beberapa kemudahan ketika itu. Semak notis terkini; jangan anggap pertunjukan muzik malam tersedia."
  }
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section id="soalan-lazim" class="bg-white py-20 sm:py-28">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sunset-600">Soalan Lazim</p>
      <h2 class="mt-3 text-balance font-display text-3xl font-extrabold text-ocean-950 sm:text-4xl">
        Soalan yang sering ditanya
      </h2>
    </div>

    <div class="mt-12 space-y-3">
      {faqs.map((f, i) => (
        <div class="faq-item overflow-hidden rounded-2xl border border-sand-200 bg-sand-50">
          <button
            type="button"
            class="faq-btn flex w-full items-center justify-between gap-4 px-5 py-4 text-left"
            aria-expanded="false"
            aria-controls={`faq-panel-${i}`}
          >
            <span class="font-semibold text-ocean-950">{f.q}</span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="faq-icon h-5 w-5 shrink-0 text-sunset-600 transition-transform" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" /></svg>
          </button>
          <div id={`faq-panel-${i}`} class="faq-panel hidden px-5 pb-5">
            <p class="text-sm leading-relaxed text-ocean-900/80">{f.a}</p>
          </div>
        </div>
      ))}
    </div>

    <p class="mt-8 text-center text-sm text-ocean-900/60">
      Masih ada soalan? Sila semak peta atau hubungi pihak berkaitan melalui pautan di bawah.
    </p>
  </div>
</section>

<script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />

<script is:inline>
  document.querySelectorAll('.faq-item').forEach((item) => {
    const btn = item.querySelector('.faq-btn');
    const panel = item.querySelector('.faq-panel');
    const icon = item.querySelector('.faq-icon');
    btn?.addEventListener('click', () => {
      if (!panel) return;
      const open = panel.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!open));
      icon?.classList.toggle('rotate-180', !open);
    });
  });
</script>

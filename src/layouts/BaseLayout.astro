---
import '../styles/global.css';
import { SITE } from '../data/site';
import { webpSrcset, webpUrl } from '../lib/images';

interface Props {
  title: string;
  description?: string;
  /** Html lang attribute for the page (default: site default Malay). */
  lang?: string;
  /** Open Graph locale (default: ms_MY). */
  ogLocale?: string;
  /** Additional JSON-LD nodes appended after the shared TouristAttraction entity. */
  extraJsonLd?: object[];
}

const { title, description = SITE.description, lang = SITE.lang, ogLocale = 'ms_MY', extraJsonLd = [] } =
  Astro.props;

// Domain dibaca daripada site Astro (astro.config.mjs). Sentiasa HTTPS — elak pendua http/https.
const siteRoot = (Astro.site ?? 'https://tanjungarubeach.com').toString().replace(/\/+$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://tanjungarubeach.com').toString();
const ogImage = new URL(SITE.heroImage, Astro.site ?? 'https://tanjungarubeach.com').toString();
const heroSrcset = webpSrcset(SITE.heroImage);

// Entiti tarikan sentiasa merujuk ke halaman utama supaya semua halaman (utama & panduan)
// mengukuhkan entiti yang sama dan bukannya bersaing.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'Beach'],
  '@id': `${siteRoot}/#pantai`,
  name: SITE.name,
  alternateName: [SITE.nameEn, SITE.nameZh],
  description: SITE.description,
  url: `${siteRoot}/`,
  image: [ogImage],
  telephone: SITE.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.locality,
    addressRegion: SITE.address.region,
    postalCode: SITE.address.postalCode,
    addressCountry: SITE.address.countryCode,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: SITE.lat,
    longitude: SITE.lng,
  },
  hasMap: SITE.mapsUrl,
  sameAs: [SITE.mapsUrl],
  isAccessibleForFree: true,
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: 'Kemasukan percuma', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Tempat letak kereta', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Tandas awam', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Gerai makanan', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Taman permainan kanak-kanak', value: true },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#0a2036" />

    <!-- Imej utama (LCP) dipra-muat dalam format WebP mengikut lebar skrin -->
    <link
      rel="preload"
      as="image"
      type="image/webp"
      href={webpUrl(SITE.heroImage, 1024)}
      imagesrcset={heroSrcset}
      imagesizes="100vw"
      fetchpriority="high"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${SITE.name} · ${SITE.nameEn}`} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${SITE.name} (${SITE.nameEn}) pada waktu senja`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Ikon (logo & favicon seragam) -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />

    <!-- Google Analytics 4 -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4Id}`}></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>

    <!-- Data Berstruktur: Pantai & Tarikan Pelancongan -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {extraJsonLd.map((node) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(node)} />
    ))}
  </head>
  <body>
    <slot />
  </body>
</html>
